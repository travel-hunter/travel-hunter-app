{
  "version": "0.1.0",
  "contractSource": "docs/mvp-api-contract.md",
  "rules": {
    "apiPrefix": "/api",
    "apiDtoCase": "camelCase",
    "dbFieldCase": "snake_case",
    "policyDetailKey": "policySlug",
    "tripDetailKey": "tripId"
  },
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/health",
      "status": 200,
      "requiredFields": {
        "status": "string",
        "service": "string",
        "environment": "string",
        "database": "string"
      },
      "example": {
        "status": "ok",
        "service": "travel-hunter-backend",
        "environment": "local",
        "database": "not_configured"
      }
    },
    {
      "method": "POST",
      "path": "/api/auth/login",
      "status": 200,
      "request": {
        "email": "jiyoung@travel.kr",
        "password": "password123"
      },
      "requiredFields": {
        "accessToken": "string",
        "user": {
          "id": "string",
          "name": "string",
          "nickname": "string",
          "email": "string",
          "birthDate": "string|null",
          "gender": "string|null",
          "region": "string|null",
          "homeRegion": "string",
          "residenceArea": "string|null",
          "preferredRegions": "string|null",
          "persona": "string",
          "savedAmount": "number",
          "onboardingCompleted": "boolean",
          "socialAccounts": "array",
          "createdAt": "string",
          "updatedAt": "string"
        }
      }
    },
    {
      "method": "POST",
      "path": "/api/auth/signup",
      "status": 200,
      "request": {
        "name": "지영",
        "email": "new-user@travel.kr",
        "password": "password123"
      },
      "requiredFields": {
        "accessToken": "string",
        "user": {
          "id": "string",
          "name": "string",
          "nickname": "string",
          "email": "string",
          "onboardingCompleted": "boolean",
          "socialAccounts": "array"
        }
      }
    },
    {
      "method": "POST",
      "path": "/api/auth/refresh",
      "status": 200,
      "requiredFields": {
        "accessToken": "string",
        "user": {
          "id": "string",
          "email": "string",
          "socialAccounts": "array"
        }
      }
    },
    {
      "method": "POST",
      "path": "/api/auth/logout",
      "status": 200,
      "requiredFields": {
        "loggedOut": "boolean"
      },
      "example": {
        "loggedOut": true
      }
    },
    {
      "method": "GET",
      "path": "/api/me",
      "status": 200,
      "requiredFields": {
        "id": "string",
        "name": "string",
        "nickname": "string",
        "email": "string",
        "homeRegion": "string",
        "onboardingCompleted": "boolean",
        "socialAccounts": "array"
      }
    },
    {
      "method": "GET",
      "path": "/api/me/profile",
      "status": 200,
      "requiredFields": {
        "region": "string",
        "style": "string",
        "budget": "string"
      },
      "dbFields": {
        "region": "users.region",
        "style": "users.travel_style",
        "budget": "users.travel_budget"
      }
    },
    {
      "method": "PATCH",
      "path": "/api/me/profile",
      "status": 200,
      "optionalRequestFields": {
        "region": "string",
        "style": "string",
        "budget": "string"
      },
      "requiredFields": {
        "region": "string",
        "style": "string",
        "budget": "string"
      },
      "dbModeBehavior": "Updates users.region, users.travel_style, users.travel_budget and marks onboarding_completed true."
    },
    {
      "method": "GET",
      "path": "/api/policies",
      "status": 200,
      "requiredArrayItemFields": {
        "id": "string",
        "slug": "string",
        "label": "string",
        "tag": "string",
        "title": "string",
        "org": "string",
        "region": "string",
        "deadline": "string",
        "amount": "string",
        "summary": "string",
        "match": "number",
        "category": "string",
        "requirements": "array",
        "documents": "array"
      },
      "exampleSlug": "local-vacation"
    },
    {
      "method": "GET",
      "path": "/api/policies/local-vacation",
      "status": 200,
      "requiredFields": {
        "id": "string",
        "slug": "string",
        "title": "string",
        "org": "string",
        "deadline": "string",
        "amount": "string"
      }
    },
    {
      "method": "GET",
      "path": "/api/trips",
      "status": 200,
      "requiredArrayItemFields": {
        "id": "string",
        "title": "string",
        "dates": "string",
        "people": "array",
        "expectedSaving": "string",
        "days": "object"
      },
      "exampleTripId": "1",
      "legacyTripAlias": "jeju-3-days",
      "dbModeTripIdPolicy": "DB mode returns numeric trip ids as strings; jeju-3-days is accepted only as a legacy seed alias.",
      "numericHandlePattern": "^[1-9][0-9]*$",
      "invalidNumericLikeHandles": ["0", "001", "1.0"]
    },
    {
      "method": "POST",
      "path": "/api/trips",
      "status": 200,
      "optionalRequestFields": {
        "title": "string",
        "region": "string",
        "style": "string",
        "description": "string",
        "policySlug": "string"
      },
      "requiredFields": {
        "id": "string",
        "title": "string",
        "dates": "string",
        "people": "array",
        "expectedSaving": "string",
        "days": "object"
      },
      "dbModePolicySlugBehavior": "When policySlug is present, create the trip and link trip_policies; unknown policySlug returns 404 Policy not found."
    },
    {
      "method": "GET",
      "path": "/api/trips/1",
      "status": 200,
      "requiredFields": {
        "id": "string",
        "title": "string",
        "dates": "string",
        "people": "array",
        "expectedSaving": "string",
        "days": "object"
      },
      "legacyAliasPath": "/api/trips/jeju-3-days",
      "legacyAliasResponseId": "numeric string"
    },
    {
      "method": "POST",
      "path": "/api/trips/1/policies/local-vacation",
      "status": 200,
      "requiredFields": {
        "tripId": "string",
        "policyId": "string",
        "added": "boolean"
      }
    },
    {
      "method": "GET",
      "path": "/api/trips/1/recommendations",
      "status": 200,
      "requiredArrayItemFields": {
        "label": "string",
        "title": "string",
        "meta": "string",
        "reason": "string"
      }
    },
    {
      "method": "GET",
      "path": "/api/trips/1/invite",
      "status": 200,
      "requiredFields": {
        "id": "string",
        "tripId": "string",
        "inviteToken": "string",
        "inviteUrl": "string",
        "expiresAt": "string",
        "createdAt": "string",
        "acceptedAt": "string|null",
        "invited": "boolean",
        "copied": "boolean"
      },
      "serverCopiedValue": false,
      "invitedMeaning": "true when a valid invite token exists or the current request created/confirmed one"
    },
    {
      "method": "POST",
      "path": "/api/invites/jeju-3d/accept",
      "status": 200,
      "requiredFields": {
        "id": "string",
        "tripId": "string",
        "inviteToken": "string",
        "inviteUrl": "string",
        "expiresAt": "string",
        "createdAt": "string",
        "acceptedAt": "string",
        "invited": "boolean",
        "copied": "boolean"
      },
      "dbModeBehavior": "Requires bearer auth, marks trip_invites.accepted_at, and inserts trip_members idempotently."
    }
  ]
}
