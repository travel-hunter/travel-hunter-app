APP_ENV=docker
POSTGRES_DB=travelhunter
POSTGRES_USER=travelhunter
POSTGRES_PASSWORD=travelhunter
PGDATA=/var/lib/postgresql/data/pgdata

DATABASE_URL=postgresql+psycopg://travelhunter:travelhunter@127.0.0.1:5432/travelhunter

AUTH_SECRET_KEY=dev-only-change-me-secret-key-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=travel_hunter_refresh
REFRESH_COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:18080,http://localhost:18080

NOTIFICATION_SCHEDULER_ENABLED=false
NOTIFICATION_RUN_AT=09:00
NOTIFICATION_POLL_SECONDS=60
NOTIFICATION_RETRY_ENABLED=true
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_SECONDS=600

EXTERNAL_COLLECTION_SCHEDULER_ENABLED=false
EXTERNAL_COLLECTION_RUN_AT=03:00
EXTERNAL_COLLECTION_POLL_SECONDS=60
EXTERNAL_COLLECTION_MIN_PARSED_COUNT=1

KAKAO_ALIMTALK_ENABLED=false
SOLAPI_BASE_URL=https://api.solapi.com
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PF_ID=
SOLAPI_TEMPLATE_ID_D7=
SOLAPI_TEMPLATE_ID_D1=
SOLAPI_FROM_NUMBER=
SOLAPI_DISABLE_SMS=true
SOLAPI_TIMEOUT_SECONDS=5
SOLAPI_WEBHOOK_SECRET=

PHONE_VERIFICATION_PROVIDER=dev
TRAVEL_HUNTER_PUBLIC_BASE_URL=http://127.0.0.1:18080

PASSWORD_RESET_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:18080/api/auth/oauth/kakao/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:18080/api/auth/oauth/google/callback

OAUTH_STATE_COOKIE_NAME=travel_hunter_oauth_state