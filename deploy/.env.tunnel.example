# Copy this file to deploy/.env.tunnel on the tunnel host and replace every example value.
# Do not commit deploy/.env.tunnel.

STAGING_DOMAIN=staging.example.com
VITE_API_BASE_URL=https://staging.example.com

POSTGRES_DB=travelhunter
POSTGRES_USER=travelhunter
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql+psycopg://travelhunter:change-me-db-password@db:5432/travelhunter

APP_ENV=staging
AUTH_SECRET_KEY=change-me-use-a-long-random-secret-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=travel_hunter_refresh
REFRESH_COOKIE_SECURE=true
CORS_ORIGINS=https://staging.example.com
NOTIFICATION_SCHEDULER_ENABLED=false
NOTIFICATION_RUN_AT=09:00
NOTIFICATION_POLL_SECONDS=60
NOTIFICATION_RETRY_ENABLED=true
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_SECONDS=600
KAKAO_ALIMTALK_ENABLED=false
SOLAPI_BASE_URL=https://api.solapi.com
SOLAPI_API_KEY=change-me-solapi-api-key
SOLAPI_API_SECRET=change-me-solapi-api-secret
SOLAPI_PF_ID=change-me-kakao-channel-pf-id
SOLAPI_TEMPLATE_ID_D7=change-me-d7-template-id
SOLAPI_TEMPLATE_ID_D1=change-me-d1-template-id
SOLAPI_FROM_NUMBER=
SOLAPI_DISABLE_SMS=true
SOLAPI_TIMEOUT_SECONDS=5
SOLAPI_WEBHOOK_SECRET=change-me-solapi-webhook-secret
TRAVEL_HUNTER_PUBLIC_BASE_URL=https://staging.example.com

CLOUDFLARE_TUNNEL_TOKEN=change-me-cloudflare-tunnel-token
